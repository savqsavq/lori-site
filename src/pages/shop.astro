---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Studio Shop">
  <section class="shop-landing">
    <h1>Studio Shop</h1>
    <p>Browse and purchase original artwork, paintings, and jewelry by Lori Renè.</p>
    <a
      href="https://lori-renartworks-studios.square.site/s/shop"
      target="_blank"
      rel="noopener noreferrer"
      class="shop-btn"
    >Visit the Shop</a>
  </section>
</Layout>

<style>
  .shop-landing {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 1.5rem;
    gap: 1.25rem;
  }

  .shop-landing h1 {
    font-size: 2.5rem;
    margin: 0;
  }

  .shop-landing p {
    font-size: 1.15rem;
    max-width: 480px;
    margin: 0;
    color: #555;
  }

  .shop-btn {
    display: inline-block;
    background: var(--pink);
    color: white;
    padding: 0.85rem 2.25rem;
    border-radius: 6px;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
    margin-top: 0.5rem;
  }

  .shop-btn:hover {
    opacity: 0.88;
  }
</style>
