---
import Layout from '../layouts/Layout.astro';

const classImages = [
  "IMG_2865.JPG", "IMG_2866.JPG", "IMG_2867.JPG", "IMG_2868.JPG"
];
---

<Layout title="Classes & Lessons">
  <div class="page-header">
    <h1>Classes & Lessons</h1>
    <p>Drawing, painting, sculpting, and more for kids and adults of all skill levels.</p>
  </div>

  <div class="content">

    <section class="private">
      <div class="private-flyer">
        <img src="/images/new_flyer_mslori.jpg" alt="Lori Renè Studios flyer - Original Artwork, Art Classes, Private Lessons, Art Parties, Face Painting" loading="lazy" />
      </div>
      <div class="private-text">
        <h2>Now Accepting Private Lesson Students</h2>
        <p>One-on-one instruction tailored to your goals, age, and skill level. Whether you're a complete beginner or looking to refine your technique, Lori works with students of all ages.</p>
        <div class="pricing">
          <div class="price-item">
            <span class="price">$65</span>
            <span class="price-label">per hour</span>
          </div>
          <div class="price-item">
            <span class="price">$220</span>
            <span class="price-label">4-pack</span>
          </div>
        </div>
        <p>Contact Lori directly for more info or to schedule a private lesson.</p>
        <a href="/contact" class="btn-secondary">Get in touch</a>
      </div>
    </section>

    <section class="workshops">
      <h2>Group Workshops</h2>
      <p>Lori also leads group art workshops for kids and adults, like the classes she ran this past summer. Sessions cover drawing, painting, and sculpture in a fun, social setting.</p>
      <p>No upcoming workshops are scheduled right now, but more may be announced soon. Contact Lori to be notified when the next session opens up.</p>
      <a href="/contact" class="btn-secondary">Get in touch</a>
    </section>

    <section class="class-gallery">
      <h2>From the Classroom</h2>
      <div class="class-grid">
        {classImages.map((img) => (
          <div class="class-img">
            <img src={`/images/classes/${img}`} alt="Art class with Lori Renè" loading="lazy" />
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>

<style>
  .page-header {
    text-align: center;
    padding: 3rem 2rem 1rem;
    background: var(--teal);
    color: white;
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    font-size: 1rem;
    opacity: 0.9;
  }

  .content {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
    text-align: center;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--pink);
    margin-bottom: 1rem;
  }

  p {
    color: #444;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .btn-secondary {
    display: inline-block;
    background: transparent;
    color: var(--pink);
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    border: 2px solid var(--pink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    background: var(--pink);
    color: white;
  }

  .private {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .private-text {
    max-width: 560px;
  }

  .private-flyer {
    max-width: 220px;
    margin-bottom: 1.5rem;
  }

  .private-flyer img {
    width: 100%;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  .pricing {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 1.5rem 0;
    flex-wrap: wrap;
  }

  .workshops {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 560px;
  }

  .price-item {
    background: var(--pink);
    color: white;
    border-radius: 8px;
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .price {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
  }

  .price-label {
    font-size: 0.85rem;
    opacity: 0.9;
  }

  .class-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    margin-top: 1rem;
  }

  .class-img {
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1;
    background: #f0f0f0;
  }

  .class-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .class-img:hover img {
    transform: scale(1.04);
  }
</style>
