---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Parties & Events">
  <div class="page-header">
    <h1>Parties & Events</h1>
    <p>Make your celebration unforgettable with art, creativity, and fun.</p>
  </div>

  <div class="content">

    <section class="events" id="events-section">
      <h2>Catch Me at a Festival!</h2>
      <p>I'll be out and about this fall — come find my table and say hi!</p>
      <div class="event-list">
        <div class="event" data-date="2026-09-19">
          <div class="event-date"><span class="month">Sep</span><span class="day">19</span></div>
          <div class="event-info">
            <h3>Let's Go Fly a Kite</h3>
            <p>The District at Eastover · Face painting</p>
          </div>
        </div>
        <div class="event" data-date="2026-09-26">
          <div class="event-date"><span class="month">Sep</span><span class="day">26</span></div>
          <div class="event-info">
            <h3>WellsFest</h3>
            <p>Mississippi Agriculture & Forestry Museum, Jackson</p>
          </div>
        </div>
        <div class="event" data-date="2026-10-03">
          <div class="event-date"><span class="month">Oct</span><span class="day">3</span></div>
          <div class="event-info">
            <h3>Day in the Country</h3>
            <p>Chapel of the Cross, Madison</p>
          </div>
        </div>
        <div class="event" data-date="2026-10-10">
          <div class="event-date"><span class="month">Oct</span><span class="day">10</span></div>
          <div class="event-info">
            <h3>The Church at Shiloh</h3>
            <p>Pelahatchie</p>
          </div>
        </div>
        <div class="event" data-date="2026-10-25">
          <div class="event-date"><span class="month">Oct</span><span class="day">25</span></div>
          <div class="event-info">
            <h3>Germanfest</h3>
            <p>St. Joseph Catholic Church, Gluckstadt</p>
          </div>
        </div>
        <div class="event" data-date="2026-11-14">
          <div class="event-date"><span class="month">Nov</span><span class="day">14</span></div>
          <div class="event-info">
            <h3>Rocket Christmas</h3>
            <p>Location to be announced</p>
          </div>
        </div>
        <div class="event" data-date="2026-11-21">
          <div class="event-date"><span class="month">Nov</span><span class="day">21</span></div>
          <div class="event-info">
            <h3>Byram Fresh Finds</h3>
            <p>Byram</p>
          </div>
        </div>
      </div>
    </section>

    <script>
      const eventsSection = document.getElementById('events-section');
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      let upcomingRemain = false;
      document.querySelectorAll('#events-section .event[data-date]').forEach((el) => {
        const eventDate = new Date(el.getAttribute('data-date') + 'T00:00:00');
        if (eventDate < today) {
          el.remove();
        } else {
          upcomingRemain = true;
        }
      });

      if (!upcomingRemain) {
        eventsSection?.remove();
      }
    </script>

    <section class="birthday">
      <div class="text">
        <h2>Birthday Parties</h2>
        <p>Lori brings the art studio to your party. Kids get to create their own masterpiece in a fun, guided setting — no experience needed, just imagination. Perfect for ages 5 and up.</p>
        <p>Contact Lori to discuss themes, group size, location, and pricing.</p>
      </div>
    </section>

    <section class="facepainting">
      <div class="text-and-image">
        <div class="text">
          <h2>Face Painting</h2>
          <p>Add some magic to your event with professional face painting by Lori Renè. Great for birthday parties, school events, festivals, and more.</p>
          <p>Available for private bookings — reach out to check availability.</p>
        </div>
        <div class="face-img">
          <img src="/images/parties-events/facepainting.jpg " alt="Face painting by Lori Renè" />
        </div>
      </div>
    </section>
    <section class="cta">
      <h2>Book Lori for Your Event</h2>
      <p>Whether it's a birthday party, face painting, or a custom event, get in touch to check availability and pricing.</p>
      <a href="/contact" class="btn-primary">Contact Lori</a>
    </section>
  </div>
</Layout>

<style>
  .page-header {
    text-align: center;
    padding: 3rem 2rem 1rem;
    background: var(--pink);
    color: white;
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    font-size: 1rem;
    opacity: 0.9;
  }

  .content {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--pink);
    margin-bottom: 1rem;
  }

  p {
    color: #444;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .events h2 { margin-bottom: 0.5rem; }

  .event-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .event {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 1.25rem;
    border: 2px solid #f0f0f0;
    border-radius: 12px;
    transition: border-color 0.2s;
  }

  .event:hover { border-color: var(--teal); }

  .event-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 10px;
    background: var(--pink);
    color: white;
  }

  .event-date .month {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .event-date .day {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
  }

  .event-info h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--dark);
    margin-bottom: 0.15rem;
  }

  .event-info p {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 0;
  }

  .text-and-image {
    display: flex;
    gap: 3rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .text-and-image .text {
    flex: 1;
    min-width: 260px;
  }

  .face-img {
    flex: 1;
    min-width: 260px;
    border-radius: 12px;
    overflow: hidden;
    border: 4px solid var(--pink);
  }

  .face-img img {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  .btn-primary {
    display: inline-block;
    background: var(--pink);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: opacity 0.2s;
  }

  .btn-primary:hover { opacity: 0.85; }

  .btn-secondary {
    display: inline-block;
    background: transparent;
    color: var(--pink);
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    border: 2px solid var(--pink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    background: var(--pink);
    color: white;
  }
  .cta {
    text-align: center;
    background: #f9f9f9;
    border-radius: 12px;
    padding: 3rem 2rem;
  }
</style>
